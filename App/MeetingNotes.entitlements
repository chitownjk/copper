<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime (required for notarization, E4.1). The app is NOT
         sandboxed: sandboxing would relocate Application Support and orphan
         existing user data (rename/migration is E3.5). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Restricted entitlement: requires an embedded provisioning profile
         (automatic signing mints one) or AMFI kills the app at launch. -->
    <key>com.apple.developer.system-extension.install</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
